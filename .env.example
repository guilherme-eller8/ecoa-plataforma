# Copie para .env.local e preencha. Nunca commite valores reais.
# Chaves secretas só no servidor (sem o prefixo NEXT_PUBLIC_). Guia: docs/setup/supabase-google-resend.md

# Supabase (projeto ecoa-plataforma, sa-east-1). Settings → API Keys → Publishable and secret keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Resend: chave só de envio, para o e-mail de acesso.
RESEND_API_KEY=

# Opcional. Endereço do app nos e-mails. Sem ela: domínio oficial em produção, URL do branch no preview.
APP_URL=

# Só para o gate de design: libera /styleguide com dados falsos no build de produção. Nunca na Vercel.
ECOA_STYLEGUIDE=

# IA (prompt 1)
ANTHROPIC_API_KEY=

# Links sem login (família; autor no prompt 5). Gere com: openssl rand -base64 32
# NUNCA edite o valor de uma versão: os links fixados nos grupos param. Para trocar,
# crie LINKS_SEGREDO_V2 e mude LINKS_VERSAO_ATUAL para 2.
LINKS_VERSAO_ATUAL=1
LINKS_SEGREDO_V1=

# Transcrição (laboratório e pipeline)
ELEVENLABS_API_KEY=
ASSEMBLYAI_API_KEY=
# elevenlabs (padrão) ou assemblyai
LAB_PROVEDOR=
# chamadas simultâneas ao Claude no lab (padrão 4)
LAB_CONCORRENCIA=

# Fila de jobs (prompt 6, Inngest). Na Vercel, a integração do Inngest cria as duas.
# No computador, deixe vazias e rode `npx inngest-cli dev` com INNGEST_DEV=1.
# NUNCA defina INNGEST_DEV na Vercel: a rota aceitaria chamadas sem assinatura.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_DEV=
