# Copie para .env.local e preencha. Nunca commite valores reais.
# Chaves secretas só no servidor (sem o prefixo NEXT_PUBLIC_). Guia: docs/setup/supabase-google-resend.md

# Supabase (projeto ecoa-plataforma, sa-east-1). Settings → API Keys → Publishable and secret keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Resend: chave só de envio, para o e-mail de acesso.
RESEND_API_KEY=

# Opcional. Endereço do app nos e-mails. Sem ela: domínio oficial em produção, URL do branch no preview.
APP_URL=

# Só para o gate de design: libera /styleguide/[tela] com dados falsos. Nunca em produção.
ECOA_PREVIA=

# IA (prompt 1)
ANTHROPIC_API_KEY=
